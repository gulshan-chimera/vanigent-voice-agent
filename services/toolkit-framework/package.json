{
  "name": "@vanigent/toolkit-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Voice agent toolkit microservice — VAPI webhook handler with tool-calling framework",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/index.js",
    "start:watch": "node --watch dist/index.js",
    "dev": "concurrently -k -n BUILD,APP -c cyan,green \"npm:build:watch\" \"npm:start:watch\"",
    "test": "npm run build && node dist/tests/mockTool.test.js",
    "test:watch": "tsc-watch -p tsconfig.json --onSuccess \"node dist/tests/mockTool.test.js\"",
    "clean": "if exist dist rmdir /s /q dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.1",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.9.2"
  }
}
