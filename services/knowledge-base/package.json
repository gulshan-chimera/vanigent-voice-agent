{
  "name": "@vanigent/knowledge-base",
  "version": "0.1.0",
  "private": true,
  "description": "Knowledge Base microservice — Azure AI Search powered RAG retrieval",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/index.js",
    "start:watch": "node --watch dist/index.js",
    "dev": "concurrently -k -n BUILD,APP -c cyan,green \"npm:build:watch\" \"npm:start:watch\"",
    "index-docs": "npm run build && node dist/scripts/indexDocuments.js",
    "sync-index": "npm run build && node dist/scripts/syncIndex.js",
    "clean": "if exist dist rmdir /s /q dist"
  },
  "dependencies": {
    "@azure/search-documents": "^12.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lru-cache": "^11.5.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "concurrently": "^9.0.1",
    "typescript": "^5.9.2"
  }
}
